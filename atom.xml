        <content type="html" xml:base="https://blog.bugslayer.ca/blog/20250823-first-post/">&lt;h1 id=&quot;paragrap&quot;&gt;Paragrap&lt;/h1&gt;
&lt;p&gt;Hello! This is my first post!&lt;/p&gt;
&lt;h2 id=&quot;some-subheading&quot;&gt;Some subheading&lt;/h2&gt;
&lt;p&gt;Let me try to show some C# code!&lt;/p&gt;
&lt;pre class=&quot;mermaid bg-inherit&quot;&gt;
  sequenceDiagram
    participant Alice
    participant Bob
    Alice-&gt;&gt;John: Hello John, how are you?
    loop Healthcheck
        John-&gt;&gt;John: Fight against hypochondria
    end
    Note right of John: Rational thoughts &lt;br/&gt;prevail!
    John--&gt;&gt;Alice: Great!
    John-&gt;&gt;Bob: How about you?
    Bob--&gt;&gt;John: Jolly good!
&lt;/pre&gt;
&lt;pre class=&quot;giallo&quot; style=&quot;color: #BFBDB6; background-color: #0D1017;&quot; &gt;&lt;code data-lang=&quot;csharp&quot;&gt;&lt;span class=&quot;giallo-l&quot;&gt;&lt;span style=&quot;color: #FF8F40;&quot;&gt;public class&lt;/span&gt;&lt;span style=&quot;color: #59C2FF;&quot;&gt; HelloWorld&lt;/span&gt;&lt;span&gt; {&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span style=&quot;color: #FF8F40;&quot;&gt;    public static void&lt;/span&gt;&lt;span style=&quot;color: #FFB454;&quot;&gt; Main&lt;/span&gt;&lt;span&gt;() {&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;        Console&lt;/span&gt;&lt;span style=&quot;color: #F29668;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #FFB454;&quot;&gt;WriteLine&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span style=&quot;color: #AAD94C;&quot;&gt;&amp;quot;Hello, world!&amp;quot;&lt;/span&gt;&lt;span&gt;)&lt;/span&gt;&lt;span style=&quot;color: #BFBDB6B3;&quot;&gt;;&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;    }&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;}&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;
&lt;p&gt;How does it look?&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;Not bad my man!&lt;/p&gt;
&lt;/blockquote&gt;
</content>
        
